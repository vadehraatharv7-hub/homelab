#!/usr/bin/env bash
# Blocks commits that contain secrets. Enable once per clone:  git config core.hooksPath .githooks
set -u

# 1. Files that must never be committed, whatever their content.
blocked=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)(terraform\.tfstate(\.backup)?|terraform\.tfvars|credential\.auto\.tfvars|inventory\.ini|.*\.pem|id_rsa.*)$' || true)
if [ -n "$blocked" ]; then
  echo "Commit blocked: these files hold secrets or state and must stay local:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  exit 1
fi

# 2. Content scan.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --redact || { echo "Commit blocked: gitleaks found a possible secret." >&2; exit 1; }
else
  echo "warning: gitleaks is not installed, so the secret scan was skipped (brew install gitleaks)." >&2
fi
