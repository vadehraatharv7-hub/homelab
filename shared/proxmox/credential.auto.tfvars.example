# Copy to credential.auto.tfvars (same folder). That file is git-ignored; never commit it.
# Every project links to it with a symlink, so these values live in exactly one place.

# Proxmox API token: Datacenter > Permissions > API Tokens
terraform_user  = "terraform@pam!homelab"            # user@realm!tokenname
terraform_token = "00000000-0000-0000-0000-000000000000"

# budget-tracker project (optional features)
# cloudflare_tunnel_token = "eyJ..."      # Cloudflare Zero Trust > Networks > Tunnels
# tailscale_auth_key      = "tskey-auth-..." # Tailscale > Settings > Keys (tag:budget, pre-approved, one-off)
