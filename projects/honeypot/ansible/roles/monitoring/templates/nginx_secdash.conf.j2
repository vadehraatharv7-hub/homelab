map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
{% if secdash_force_https | default(false) %}

    # Credentials travel in these requests, so send everything to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}

    include /etc/nginx/snippets/secdash_locations.conf;
{% endif %}
}

# HTTPS with a self-signed certificate (generated by Ansible). Replace
# /etc/ssl/secdash/ with a real certificate when the dashboard gets a hostname.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate     /etc/ssl/secdash/fullchain.pem;
    ssl_certificate_key /etc/ssl/secdash/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    include /etc/nginx/snippets/secdash_locations.conf;
}

# Sensor ingest and the ban list polled by xdp-shield (private network only; see the NSG)
server {
    listen 8081;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
