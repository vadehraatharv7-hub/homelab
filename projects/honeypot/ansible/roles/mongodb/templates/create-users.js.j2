// Creates (or updates) the two accounts. Passwords come from the environment, never from the command line.
function ensureUser(database, name, pwd, roles) {
  if (database.getUser(name)) {
    database.updateUser(name, { pwd: pwd, roles: roles });
  } else {
    database.createUser({ user: name, pwd: pwd, roles: roles });
  }
}
