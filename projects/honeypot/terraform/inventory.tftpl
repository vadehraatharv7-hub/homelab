# Generated by Terraform (Homelab). Contains database passwords: do not commit.

# The Proxmox host: used only to confirm the unattended installs (proxmox-installs.yml).
[proxmox]
pve ansible_host=${pve_host} ansible_user=${pve_user}%{ if pve_key != "" } ansible_ssh_private_key_file=${pve_key}%{ endif }

[honeypot]
${hostnames.honeypot} ansible_host=${honeypot_ip} vmid=${vmids.honeypot}

[snare]
${hostnames.snare} ansible_host=${snare_ip} vmid=${vmids.snare}

[monitoring]
${hostnames.monitoring} ansible_host=${monitoring_ip} vmid=${vmids.monitoring}

[database]
${hostnames.database} ansible_host=${database_ip} vmid=${vmids.database}

[vms:children]
honeypot
snare
monitoring
database

[vms:vars]
ansible_user=${admin_user}
ansible_port=22222
ansible_ssh_private_key_file=${private_key}
# The VMs are rebuilt from scratch, so their host keys change.
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'

[all:vars]
# The dashboard reads this as its MongoDB connection string (it is Cosmos DB's name in the Azure setup).
cosmos_db_uri="${mongo_uri}"
monitoring_ip="${monitoring_ip}"
# Where the sensors send events and where xdp-shield fetches the ban list.
monitoring_private_ip="${monitoring_ip}"
database_host="${database_ip}"
admin_cidr="${admin_cidr}"
mongo_app_user="secdash"
mongo_app_password="${mongo_password}"
mongo_admin_user="mongoadmin"
mongo_admin_password="${mongo_admin_pw}"
mongo_db_name="honeypot_db"
